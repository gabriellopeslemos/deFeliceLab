# Copy this file to .env and fill in real values. Never commit .env.
#
# Register an app at https://orcid.org/developer-tools to get a Client ID/Secret
# for the ORCID Public API (Client Credentials Grant, read-only). See readme.md
# for the full walkthrough.

ORCID_CLIENT_ID=xxxx-xxxx-xxxx-xxxx
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Comma-separated ORCID iDs (format 0000-0000-0000-0000) for the lab's researchers
ORCID_IDS=0000-0000-0000-0000
